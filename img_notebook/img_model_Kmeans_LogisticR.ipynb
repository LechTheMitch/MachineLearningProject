   "id": "d976c635",
   "metadata": {},
   "outputs": [],
   "source": [
    "# reading dataset paths\n",
    "dataset_path = r\"../img_dataset\"\n",
    "\n",
    "Parasitized_path = os.path.join(dataset_path, 'Parasitized')\n",
    "Uninfected_path = os.path.join(dataset_path, 'Uninfected')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "3ffa8e32",
   "metadata": {},
   "outputs": [],
   "source": [
    "# loading images without any processing\n",
    "def load_images(folder_path, label):\n",
    "    images = [] # list to store images\n",
    "    labels = [] # list to store labels\n",
    "    count = 0 # counter for images\n",
    "\n",
    "    for root, dirs, files in os.walk(folder_path): # root: current directory, files: files in current directory(images) , dirs: subdirectories in that file \"we won't use dirs here\"\n",
    "        for filename in files: \n",
    "            if not filename.lower().endswith((\".png\", \".jpg\", \".jpeg\")): # skip non-images\n",
    "                continue\n",
    "            img_path = os.path.join(root, filename)\n",
    "            img = cv2.imread(img_path,0)    # color mode -> 1 , grayscale -> 0 , unchanged -> -1  -- grayscale is 1channel, 2D array type uint8 \n",
    "            if img is None:                 # check if image is loaded successfully\n",
    "                continue\n",
    "\n",
    "            images.append(img)\n",
    "            labels.append(label)\n",
    "            count += 1\n",
    "\n",
    "    return images, labels, count"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "44351576",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
