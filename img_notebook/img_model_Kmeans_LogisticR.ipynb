   "source": [
    "# preprocessing function\n",
    "def img_preprocessing(images , target_size = (64,64)):\n",
    "    processed = []    # list to store processed images, if we append on \"images\" it will modify the original images\n",
    "    for img in images:\n",
    "        img_resized = cv2.resize(img, target_size)                    # resize           ---  64x64   -the reason of 64: reduce computational load while retaining\n",
    "        img_norm = img_resized.astype('float32') / 255.0              # normalization    ---  by making pixel from [0,255] to [0,1]\n",
    "        img_flat = img_norm.flatten()                                 # flatten          ---  from 2D to 1D array\n",
    "        processed.append(img_flat)\n",
    "    return processed"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "211534ab",
   "metadata": {},
   "outputs": [],
   "source": [
