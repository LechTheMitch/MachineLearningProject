    "for cluster in range(2):\n",
    "    plt.scatter(\n",
    "        X_pca[labels == cluster, 0], \n",
    "        X_pca[labels == cluster, 1], \n",
    "        label=f'Cluster {cluster}'\n",
    "    )\n",
    "\n",
    "plt.xlabel('PCA 1')\n",
    "plt.ylabel('PCA 2')\n",
